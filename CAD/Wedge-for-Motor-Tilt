// Rear motor wedge
// Bottom angle: 33.94 degrees
// Flat top for motor
// Dimensions: 20mm long x 24mm wide
// Thin end: 3mm

angle = 33.94;

length = 20;
width = 24;
thin_end = 3;

rise = length * tan(angle);
top_height = thin_end + rise;

polyhedron(
    points = [
        [0, 0, 0],
        [0, width, 0],
        [length, width, rise],
        [length, 0, rise],

        [0, 0, top_height],
        [0, width, top_height],
        [length, width, top_height],
        [length, 0, top_height]
    ],

    faces = [
        [0, 3, 2, 1],   // angled bottom
        [4, 5, 6, 7],   // flat top
        [0, 1, 5, 4],
        [1, 2, 6, 5],
        [2, 3, 7, 6],
        [3, 0, 4, 7]
    ]
);
